# 生产环境配置【模板】——复制成 application-prod.yml 后再填值
#   cp application-prod.yml.example application-prod.yml
# 注意：application-prod.yml 已被 .gitignore 忽略（防止误提交生产配置），所以本模板才入库。
# 生产环境配置（模板，2026-09-14 新建 · 生产前置清单第 13 项）
#
# 用法：启动时指定 profile —— java -jar jjx-server/target/jjx-server-1.0.0.jar --spring.profiles.active=prod
# 原则：
#   1. 本文件**不含任何明文口令**，全部走环境变量；未设的必填项应让服务启动失败（宁可不启动，不要带默认口令跑）
#   2. 与 application-dev.yml 保持同名字段，改动只体现在"生产口径"上（去掉 devtools 热重载、不打 SQL、连接池放大等）
#   3. 上线前必须替换的变量见文末清单
#
# 环境变量清单（上线前填）：
#   DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD     业务库（应用账号，最小权限）
#   REDIS_HOST / REDIS_PORT / REDIS_PASSWORD
#   JWT_SECRET                                              必须换成生产私有值（否则 token 可被伪造）
#   JJX_UPLOAD_ROOT                                         上传根绝对路径（生产路径）

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://${DB_HOST:127.0.0.1}:${DB_PORT:3306}/${DB_NAME:jjx_erp_db}?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
    username: ${DB_USER:jjx_app}
    password: ${DB_PASSWORD}
    hikari:
      connection-timeout: 30000
      maximum-pool-size: 30
      minimum-idle: 10
      idle-timeout: 600000
      max-lifetime: 1800000

  data:
    redis:
      host: ${REDIS_HOST:127.0.0.1}
      port: ${REDIS_PORT:6379}
      password: ${REDIS_PASSWORD:}
      database: 0
      timeout: 3000ms
      lettuce:
        pool:
          max-active: 20
          max-wait: -1ms
          max-idle: 10
          min-idle: 0

  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 100MB

  # 生产关闭热重载
  devtools:
    restart:
      enabled: false

# MyBatis Plus：生产不打 SQL、不刷新 mapper
mybatis-plus:
  type-aliases-package: com.jjx.**.domain
  type-enums-package: com.jjx.**.enums
  mapper-locations:
    - classpath*:mapper/**/*.xml
    - classpath*:com/jjx/**/mapper/**/*.xml
  global-config:
    db-config:
      id-type: AUTO
      field-strategy: NOT_NULL
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0
    refresh: false
  configuration:
    map-underscore-to-camel-case: true
    call-setters-on-nulls: true
    # 生产不打印 SQL（dev 用的是 StdOutImpl）
    log-impl: org.apache.ibatis.logging.nologging.NoLoggingImpl

sa-token:
  token-name: token
  timeout: 2592000
  active-timeout: 1800
  is-concurrent: true
  is-share: false
  token-style: uuid
  is-log: true
  # 必须由环境变量注入（无默认值）
  jwt-secret-key: ${JWT_SECRET}
  is-print: false

# 上传根：生产必须显式设置绝对路径（不要依赖相对路径/启动目录）
file:
  upload:
    path: ${JJX_UPLOAD_ROOT}

# 日志：生产写文件（轮转由 logback 配置决定），级别 INFO
logging:
  level:
    root: info
    com.jjx: info
