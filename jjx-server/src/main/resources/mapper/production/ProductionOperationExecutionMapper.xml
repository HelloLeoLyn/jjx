<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jjx.production.mapper.ProductionOperationExecutionMapper">

    <!-- 通用查询结果映射 -->
    <resultMap id="BaseResultMap" type="com.jjx.production.domain.entity.ProductionOperationExecution">
        <id column="execution_id" property="executionId"/>
        <result column="order_id" property="orderId"/>
        <result column="process_id" property="processId"/>
        <result column="process_order" property="processOrder"/>
        <result column="planned_start_time" property="plannedStartTime"/>
        <result column="planned_end_time" property="plannedEndTime"/>
        <result column="actual_start_time" property="actualStartTime"/>
        <result column="actual_end_time" property="actualEndTime"/>
        <result column="actual_labor_hours" property="actualLaborHours"/>
        <result column="actual_machine_hours" property="actualMachineHours"/>
        <result column="equipment_id" property="equipmentId"/>
        <result column="equipment_code" property="equipmentCode"/>
        <result column="equipment_name" property="equipmentName"/>
        <result column="operator_id" property="operatorId"/>
        <result column="operator_name" property="operatorName"/>
        <result column="input_quantity" property="inputQuantity"/>
        <result column="output_quantity" property="outputQuantity"/>
        <result column="qualified_quantity" property="qualifiedQuantity"/>
        <result column="defective_quantity" property="defectiveQuantity"/>
        <result column="defective_reason" property="defectiveReason"/>
        <result column="actual_process_params" property="actualProcessParams"/>
        <result column="quality_check_result" property="qualityCheckResult"/>
        <result column="execution_status" property="executionStatus"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 带关联信息的查询结果映射 -->
    <resultMap id="WithOrderResultMap" type="com.jjx.production.domain.entity.ProductionOperationExecution" extends="BaseResultMap">
        <association property="productionOrder" javaType="com.jjx.production.domain.entity.ProductionOrder">
            <id column="po_order_id" property="orderId"/>
            <result column="po_order_no" property="orderNo"/>
            <result column="po_product_id" property="productId"/>
            <result column="po_product_code" property="productCode"/>
            <result column="po_product_name" property="productName"/>
            <result column="po_product_spec" property="productSpec"/>
            <result column="po_product_unit" property="productUnit"/>
            <result column="po_planned_quantity" property="plannedQuantity"/>
            <result column="po_completed_quantity" property="completedQuantity"/>
            <result column="po_order_status" property="orderStatus"/>
        </association>
    </resultMap>

    <!-- 根据订单ID查询工序执行列表（带工单信息） -->
    <select id="selectByOrderId" resultMap="WithOrderResultMap">
        SELECT
            e.*,
            o.order_id AS po_order_id,
            o.order_no AS po_order_no,
            o.product_id AS po_product_id,
            o.product_code AS po_product_code,
            o.product_name AS po_product_name,
            o.product_spec AS po_product_spec,
            o.product_unit AS po_product_unit,
            o.planned_quantity AS po_planned_quantity,
            o.completed_quantity AS po_completed_quantity,
            o.order_status AS po_order_status
        FROM production_operation_execution e
        LEFT JOIN production_order o ON e.order_id = o.order_id
        WHERE e.order_id = #{orderId}
        ORDER BY e.process_order ASC
    </select>

    <!-- 根据工序ID查询工序执行 -->
    <select id="selectByProcessId" resultMap="BaseResultMap">
        SELECT * FROM production_operation_execution
        WHERE process_id = #{processId}
        ORDER BY create_time DESC
    </select>

    <!-- 根据操作员ID查询工序执行 -->
    <select id="selectByOperatorId" resultMap="BaseResultMap">
        SELECT * FROM production_operation_execution
        WHERE operator_id = #{operatorId}
        ORDER BY create_time DESC
    </select>

    <!-- 根据设备ID查询工序执行 -->
    <select id="selectByEquipmentId" resultMap="BaseResultMap">
        SELECT * FROM production_operation_execution
        WHERE equipment_id = #{equipmentId}
        ORDER BY create_time DESC
    </select>

</mapper>
