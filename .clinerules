]
```

### API 层统一规范

```typescript
import request from '@/utils/request'
import type { PageResult, R } from '@/types'
import type { SysXxx, SysXxxDTO, SysXxxQuery } from '@/types/system'

export const xxxApi = {
  // 列表查询（分页）
  list(params: SysXxxQuery) {
    return request.get<R<PageResult<SysXxx>>>('/system/xxx/list', { params })
  },
  // 列表查询（全量）
  all(params?: SysXxxQuery) {
    return request.get<R<SysXxx[]>>('/system/xxx/all', { params })
  },
  // 详情
  getInfo(id: number) {
    return request.get<R<SysXxx>>(`/system/xxx/${id}`)
  },
  // 新增
  add(data: SysXxxDTO) {
    return request.post<R<void>>('/system/xxx', data)
  },
  // 修改
  edit(data: SysXxxDTO) {
    return request.put<R<void>>('/system/xxx', data)
  },
  // 删除
  remove(ids: number[]) {
    return request.delete<R<void>>(`/system/xxx/${ids.join(',')}`)
  },
}
```

### 类型定义规范

```typescript
// types/system/xxx.ts
export interface SysXxx {
  id?: number
  xxxName?: string
  status?: string // '0'=正常 '1'=停用
  createTime?: string
  // ...
}

export interface SysXxxDTO {
  id?: number // 修改时有值，新增时无值
  xxxName: string
  status: string
  // ...
}

export interface SysXxxQuery {
  pageNum?: number
  pageSize?: number
  xxxName?: string
  status?: string
}
```

### 前端关键规则

| 规则               | 说明                                                                      |
| ------------------ | ------------------------------------------------------------------------- |
| **导入顺序**       | Vue API → Element Plus → 公共组件 → API → 类型 → 配置 → 工具函数 → 子组件 |
| **parseTime**      | 统一从 `@/utils/format` 导入，禁止本地重复定义                            |
| **assignExisting** | 表单数据回填使用 `@/utils/object` 的 `assignExisting`                     |
| **配置导出**       | 统一使用 `export const` 风格                                              |
| **未使用代码**     | 禁止保留未使用的变量、函数、导入                                          |
| **错误处理**       | API 调用使用 try/catch，catch 中 `console.error`                          |
| **分页参数**       | 统一 `pageNum` / `pageSize`                                               |
| **状态标签**       | 统一使用 `<el-tag>`，`0`=正常(success)，`1`=停用(danger)                  |
| **权限指令**       | 操作按钮统一使用 `v-hasPermi`                                             |
| **对话框**         | 表单对话框抽取为独立组件放在 `components/` 目录                           |
| **样式**           | 使用 `scoped lang="scss"`，容器类名统一为 `{name}-container`              |
| **代码注释**       | 使用 `// ==================== 标题 ====================` 分隔代码块       |
| **组件命名**       | 主页面 `index.vue`，配置 `index.ts`，对话框 `XxxFormDialog.vue`           |
| **枚举使用**       | 状态枚举统一使用 `StatusEnum` 常量对象                                    |

## ==================== 权限编码规范 ====================

### 权限标识命名规范

#### 1. 格式

```
模块:功能:操作（全小写英文，冒号分隔）
```

#### 2. 标准CRUD操作

| 操作     | 权限标识示例         | 说明                         |
| -------- | -------------------- | ---------------------------- |
| `view`   | `system:user:view`   | 查看（包含列表、详情、查询） |
| `add`    | `system:user:add`    | 新增                         |
| `edit`   | `system:user:edit`   | 编辑                         |
| `delete` | `system:user:delete` | 删除                         |
| `export` | `system:user:export` | 导出（可选）                 |
| `import` | `system:user:import` | 导入（可选）                 |

#### 3. 特殊状态操作

对于状态流转等特殊操作，使用动词描述：

```
product:status:release    # 产品发布
product:status:submit     # 提交审核
product:status:approve    # 审核通过
product:status:reject     # 驳回
product:status:obsolete   # 停用
```

#### 4. 模块权限前缀

| 模块     | 权限前缀     | 示例                     |
| -------- | ------------ | ------------------------ |
| 系统管理 | `system`     | `system:user:view`       |
| 销售管理 | `sales`      | `sales:order:view`       |
| 库存管理 | `inventory`  | `inventory:material:add` |
| 产品管理 | `product`    | `product:status:release` |
| 采购管理 | `purchase`   | `purchase:order:view`    |
| 生产管理 | `production` | `production:order:view`  |

### 后端权限编码规范

#### 1. @SaCheckPermission 使用规范

- 所有写操作（POST/PUT/DELETE）必须添加 @SaCheckPermission
- 读操作（GET）根据业务需求选择性添加
- @SaCheckPermission 放在 @Log 之后、方法返回类型之前

```java
@PostMapping
@Log(module = "用户管理", businessType = BusinessType.INSERT)
@SaCheckPermission("system:user:add")
public Result<Void> add(@Validated @RequestBody SysUserDTO dto) {
    return toAjax(userService.insertUser(dto));
}
```

#### 2. @Log 注解 module 命名规范

- 统一使用中文 `XXX管理` 格式
- 同一个 Controller 内所有 @Log 的 module 必须一致
- 示例：`用户管理`、`角色管理`、`菜单管理`、`部门管理`、`产品管理`

```java
// ✅ 正确
@Log(module = "用户管理", businessType = BusinessType.INSERT)

// ❌ 错误
@Log(module = "用户信息", businessType = BusinessType.INSERT)
@Log(module = "product:status:release", businessType = BusinessType.UPDATE)
```

#### 3. Controller 返回类型规范

- 列表接口统一返回 VO，禁止直接返回 Entity
- 详情接口返回 VO
- 写操作返回 `Result<Void>`

```java
// ✅ 正确
@GetMapping("/list")
public Result<PageResult<SysUserVO>> list(SysUser query) {
    PageResult<SysUserVO> result = userService.selectUserVOList(query, pageNum, pageSize);
    return Result.success(result);
}

// ❌ 错误 - 直接返回 Entity
public Result<PageResult<SysUser>> list(SysUser query) {
    PageResult<SysUser> result = userService.selectUserList(query, pageNum, pageSize);
    return Result.success(result);
}
```

#### 4. @Log 注解位置规范

- `@Log` 放在 `@RequestMapping` 之后、方法返回类型之前
- 所有写操作（POST/PUT/DELETE）必须添加 @Log 注解

```java
@PostMapping
@Log(module = "用户管理", businessType = BusinessType.INSERT)
public Result<Void> add(@Validated @RequestBody SysUserDTO dto) {
    return toAjax(userService.insertUser(dto));
}
```

### 前端权限编码规范

#### 1. 权限检查方式

| 方式                         | 使用场景            | 示例                                           |
| ---------------------------- | ------------------- | ---------------------------------------------- |
| `v-hasPermi` 指令            | 模板中控制元素显隐  | `<el-button v-hasPermi="['system:user:add']">` |
| `v-hasRole` 指令             | 模板中控制角色显隐  | `<el-button v-hasRole="['admin']">`            |
| `usePermission()` composable | script 中编程式检查 | `hasPermission('system:user:add')`             |

**规则：**

- 模板中统一用 `v-hasPermi` / `v-hasRole` 指令
- script 中统一用 `usePermission()` composable
- 禁止在组件中直接使用 `userStore.hasPermission`（应通过 composable 封装）

#### 2. 权限标识枚举化

使用 `@/enums/permissions` 中的 `Permissions` 常量对象，避免硬编码字符串：

```typescript
import { Permissions } from '@/enums/permissions'

// ✅ 正确 - 使用枚举
v-hasPermi="[Permissions.SYSTEM_USER_ADD]"

// ❌ 错误 - 硬编码字符串
v-hasPermi="['system:user:add']"
```

#### 3. 权限标识命名规范

```
格式：模块_功能_操作（全大写，下划线分隔）
值格式：模块:功能:操作（全小写，冒号分隔）
示例：SYSTEM_USER_ADD = 'system:user:add'
```

## ==================== 禁止事项 ====================

1. 禁止字段注入 (@Autowired, @Resource on fields)
2. 禁止手写 Entity → VO 转换代码（使用 MapStruct）
3. 禁止 Controller 中写业务逻辑
4. 禁止在循环中操作数据库
5. 禁止在 Controller 中返回 `Result.error()`（应抛出 `BusinessException`）
6. 禁止保留未使用的变量、函数、导入
7. 禁止本地重复定义 `parseTime` 等工具函数
8. 禁止 API 层方法名与后端接口语义不一致

## ==================== 常用命令 ====================

- 启动后端: mvn spring-boot:run
- 编译后端: mvn clean package -DskipTests
- 测试后端: mvn test
- 格式化后端: mvn spotless:apply
- 启动前端: pnpm dev
- 构建前端: pnpm build

## ==================== 测试要求 ====================

- 单元测试: JUnit 5 + Mockito
- 集成测试: @SpringBootTest
- 核心逻辑覆盖率 > 80%
