#!/usr/bin/env bash
# JJX pre-commit 闸门 · 内容类（拦"不可逆"的改动）
# 生效前提：git config core.hooksPath scripts/hooks  → 跑 bash scripts/install-hooks.sh
# 人工覆盖：git commit --no-verify（只在确认过后果时用）
# 规则出处：AGENTS.md / jjx-docs/standards/CONVENTIONS.md §5

set -uo pipefail
cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 1

fail=0
say() { printf '%s\n' "$*"; }

# ── 闸门 1：正式SQL/规范保护；只放行同名、原内容的applied归档 ────────
if ! python3 - <<'PYHOOK'
import pathlib, re, subprocess, sys

def git(*args):
    return subprocess.check_output(['git', *args])
raw=git('diff','--cached','--no-renames','--name-status','-z').split(b'\0')
changes={}
for i in range(0,len(raw)-1,2):
    changes[raw[i+1].decode()] = raw[i].decode()
failures=[]
for source,status in changes.items():
    if status!='D': continue
    if source.startswith('jjx-docs/sql/backups/'):
        print(f'⚠ 历史备份清理须用户授权及独立任务：{source}')
        continue
    if not source.startswith(('jjx-docs/sql/','jjx-docs/standards/')): continue
    name=pathlib.PurePosixPath(source).name
    target='jjx-docs/sql/migrations/applied/'+name
    allowed=(pathlib.PurePosixPath(source).parent.as_posix()=='jjx-docs/sql/migrations'
             and re.fullmatch(r'[0-9]+_[A-Za-z0-9][A-Za-z0-9._-]*\.sql',name)
             and changes.get(target)=='A')
    if allowed:
        # 用blob相等判定，不依赖Git相似度或rename配对猜测。
        allowed=git('rev-parse','HEAD:'+source).strip()==git('rev-parse',':'+target).strip()
    if allowed:
        print(f'✓ 同名内容不变的迁移归档：{source} → {target}')
    else:
        failures.append(source)
if failures:
    print('✘ 禁止删除/移动正式SQL或规范；唯一新增例外为 migrations/NN_x.sql → migrations/applied/NN_x.sql，内容必须不变')
    for p in failures: print('  '+p)
    sys.exit(1)
PYHOOK
then fail=1; fi

# ── 闸门 2：状态魔法值基线只许缩小（AGENTS.md：不许新增违规）──────────────
BASE='jjx-web/scripts/status-magic-baseline.json'
if git diff --cached --name-only | grep -qx "$BASE"; then
  out=$(python3 - "$BASE" <<'PY'
import json, subprocess, sys
p = sys.argv[1]

def load(rev):
    r = subprocess.run(["git", "show", f"{rev}:{p}"], capture_output=True, text=True)
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout).get("findings", {}) or {}
    except Exception:
        return None

old, new = load("HEAD"), load("")
if new is None:
    print("  ✘ 基线文件在暂存区不可读，或已被删除/未加入暂存区")
    print("     （合法维护只能通过减小条目；新增文件请走 npm run check:status-enums -- --write-baseline 并复核）")
    sys.exit(1)
if old is None:
    print("  ✘ 基线文件是新增的（HEAD 中不存在）——建基线必须先复核全部条目，不允许顺手带进提交")
    sys.exit(1)
old = old or {}
added = [k for k in new if k not in old]
increased = [(k, old[k], new[k]) for k in new if k in old and new[k] > old[k]]
if added or increased:
    for k in added[:10]:
        print("  新增条目: " + k[:110])
    for k, o, n in increased[:10]:
        print(f"  数值增大: {o} -> {n}  {k[:90]}")
    sys.exit(1)
removed = [k for k in old if k not in new]
print(f"  ✓ 基线只减不增（本次减少 {len(removed)} 条）")
sys.exit(0)
PY
) || {
    say ""
    say "✘ 拦截：status-magic-baseline.json 只许缩小，不许新增/放大（AGENTS.md 状态枚举条款）"
    say "$out"
    say "  正确做法：改业务代码让违规消失，而不是把它写进基线"
    fail=1
  }
  [ -n "$out" ] && say "$out"
fi

if [ "$fail" -ne 0 ]; then
  say ""
  say "（确认无误要强行提交：git commit --no-verify）"
  say ""
  exit 1
fi
exit 0
