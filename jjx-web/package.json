{
  "name": "jjx-web",
  "version": "1.0.0",
  "description": "JJX ERP系统前端",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VITE_APP_BRANCH=$(git rev-parse --abbrev-ref HEAD) vite",
    "dev:win": "for /f %i in ('git rev-parse --abbrev-ref HEAD') do set VITE_APP_BRANCH=%i && vite",
    "build": "npm run check:status-enums && VITE_APP_BRANCH=$(git rev-parse --abbrev-ref HEAD) vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "lint:check": "eslint . --ext .vue,.js,.ts,.jsx,.tsx",
    "format:check": "prettier --check .",
    "check:status-enums": "node scripts/check-status-magic-values.mjs",
    "test:status-enums": "node scripts/check-status-magic-values.mjs --self-test",
    "validate": "npm run check:status-enums && vue-tsc --noEmit"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.13.6",
    "dayjs": "^1.11.20",
    "element-plus": "^2.13.5",
    "js-cookie": "^3.0.5",
    "lodash-es": "^4.17.23",
    "nprogress": "^0.2.0",
    "path-browserify": "^1.0.1",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^2.3.1",
    "qrcode": "^1.5.4",
    "screenfull": "^6.0.2",
    "sortablejs": "1.14.0",
    "vue": "^3.4.0",
    "vue-cropper": "^1.1.3",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.4",
    "vuedraggable": "4.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.19.37",
    "@types/path-browserify": "^1.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "fast-glob": "^3.3.3",
    "prettier": "^3.8.1",
    "sass": "^1.98.0",
    "typescript": "~5.3",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^8.0.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
